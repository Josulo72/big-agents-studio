{
  "name": "chat-traductor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "check:secrets": "node scripts/check-bundle-secrets.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "verify:webpush": "esbuild supabase/functions/translate-message/webpush.ts --format=esm --outfile=node_modules/.tmp-webpush.mjs --log-level=error && node scripts/verify-webpush.mjs node_modules/.tmp-webpush.mjs",
    "bundle:function": "esbuild supabase/functions/translate-message/index.ts --bundle --format=esm --platform=neutral --target=es2022 --external:'jsr:*' --external:'npm:*' --external:'https://*' --outfile=supabase/functions/translate-message/BUNDLE.ts --banner:js=\"// VERSION DE UN SOLO FICHERO - generada por 'npm run bundle:function', no editar a mano.\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.2",
    "http_ece": "^1.2.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  }
}
