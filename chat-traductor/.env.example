# Copiar a `.env` y rellenar.
#
# Solo estas variables llegan al navegador. Todo lo que lleve el prefijo VITE_
# acaba en el bundle: no pongas aquí ni la clave de DeepL, ni la service_role,
# ni la clave VAPID *privada*. Esas viven solo en los secrets de Supabase.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clave pública (anon / publishable). Es segura en el cliente: RLS es lo que
# protege los datos.
VITE_SUPABASE_ANON_KEY=

# Opcional. Si se deja vacío, la app usa la primera sala de la que el usuario
# sea miembro, que con una sola sala es siempre la correcta.
VITE_ROOM_ID=

# Clave VAPID *pública* para las notificaciones. Es pública por diseño: va en
# el bundle a propósito. Si se deja vacía, la app funciona igual pero sin
# avisos, y el botón de notificaciones no aparece.
VITE_VAPID_PUBLIC_KEY=
